# Copia este archivo a .env y pon tus llaves.
# .env está en .gitignore: nunca se sube al repositorio.
#
# El entorno del sistema tiene prioridad sobre este archivo, así que puedes
# probar una llave distinta sin editarlo:
#     $env:ELEVENLABS_API_KEY = "otra"; .\agente-video.exe generar ...

# Guionista (obligatoria)
ANTHROPIC_API_KEY=sk-ant-...
# Solo si tu llave está vinculada a identidad
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Imágenes por Cloudflare (opcional; sin esto se usa Pollinations)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Voz por ElevenLabs (opcional; sin esto se usa Piper en local)
ELEVENLABS_API_KEY=
