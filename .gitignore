# Binarios externos y modelos: los descarga instalar.ps1 (cientos de MB)
/bin/

# Checkpoints y videos generados
/trabajo/
/salida/

# Ejecutable compilado. Va anclado con "/" para no excluir por accidente el
# directorio cmd/agente-video/, que sí es código fuente.
/agente-video
/agente-video.exe

# Credenciales
.env

# Música y efectos: binarios pesados, con licencias propias
/assets/

# Dependencias y build de la interfaz. dist/ se empotra en el binario al
# compilar, así que no tiene sentido versionarlo.
/interfaz/node_modules/
/interfaz/dist/*
!/interfaz/dist/mantener.txt
